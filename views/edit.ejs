<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
     <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="bg-zinc-900 w-full  min-h-screen  text-white p-10">
        <a class="bg-red-500 rounded-md px-3 py-2 text-sm inline-block mb-5" href="/logout">Logout</a>
        <h5 class="mb-5">Edit Your Post</h5>
        <form method="post" action="/update/<%= post._id %>">
            <textarea placeholder="what's on your mind" class="p-3 outline-none  w-1/3 resize-none bg transprent border-2 bg-zinc-900 rounded-md" name="content" ><%= post.content %></textarea>
            <input class="px-3 py-2 bg-yellow-500 rounded-md block mt-2 w-42" type="submit" value="Update a Post">
        </form>
    </div>
</body>
</html>