<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
     <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="bg-zinc-900 w-full  min-h-screen  text-white p-10">
        <h3>Login Your Account Create</h3>
      <form action="/login" method="post">
        <input class="px-3 py-2 outline-one border-2 border-zinc-800" type="email" placeholder="email" name="email">
        <input class="px-3 py-2 outline-one border-2 border-zinc-800" type="password" placeholder="password" name="password">
        <input class="px-3 py-2 bg-blue-500 rounded-md" type="submit"  value="Login Account">
      </form>
    </div>
</body>
</html>