<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
     <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="bg-zinc-900 w-full  min-h-screen  text-white p-10">
        <a class="bg-red-500 rounded-md px-3 py-2 text-sm inline-block mb-5" href="/logout">Logout</a>
        <div class="flex gap-4 item-center">
             <div class="w-10 h-10 rounded-md overflow-hidden">
                <img src="/images/uploads/<%= user.profilepic %>" alt="" srcset="">
             </div>
        <h3 class="text-3xl">Hello,<%= user.name%></h3>
        </div>
        <h5 class="mb-5 mt-4">You Can Create A new post</h5>
        <form method="post" action="/post">
            <textarea placeholder="what's on your mind" class="p-3 outline-none  w-1/3 resize-none bg transprent border-2 bg-zinc-900 rounded-md" name="content" id=""></textarea>
            <input class="px-3 py-2 bg-blue-500 rounded-md block mt-2 w-42" type="submit" value="Create New Post">
        </form>
        <div class="posts mt-20">
            <h3 class="text-zinc-400">Your Post</h3>
            <div class="postcontainer mb-2" >
                <% user.posts.reverse().forEach(function(post){ %>
                   <div   class="post w-1/3 p-5 border-2 border-zinc-800 p-4 rounded-md">
                    <div class="flex gap-0.5 item-center mb-5">
                        <img class="w-8 h-8 rounded-xl overflow-hidden" src="/images/uploads/<%= user.profilepic %>" alt="" srcset="">
                        <h4 class="text-blue-500 mb-2 text-2xl">@<%= user.username %></h4>
                    </div>
                      
                      <p class="text-sm tracking tighter"><%= post.content %></p>
                      <small class="mt-2 lnline-block"><%= post.likes.length %> likes</small>
                      <div class="btns-flex mt-5 gap-5">
                         <a class="text-blue-500" href="/like/<%= post._id %>">
                            <%= post.likes.indexOf(user._id)===-1 ?"like" : "unlike"  %>
                         </a>
                         <a class="text-zinc-400" href="/edit/<%= post._id  %>">Edit</a>
                      </div>
                 </div>
               <% })  %>
            </div>
        </div>
    </div>
</body>
</html>